{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nexus Agents",
  "version": "0.1.0",
  "identifier": "dev.nexus.agents",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Nexus — Centre de contrôle des agents",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "decorations": true,
        "backgroundColor": "#03040a"
      }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:" }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/icon.png"] }
}
